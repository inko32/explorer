+/// Gets the raw Wayland window handles of the window with the given [`Id`],
+/// as opaque pointers: `(wl_surface, wl_display, xdg_toplevel)`.
+/// `None` on non-Wayland.
+///
+/// The pointers are only meaningful while the window is alive and must only
+/// be used on the thread running the event loop.
+pub fn raw_handle(id: Id) -> Task<Option<(usize, usize, usize)>> {
+    task::oneshot(move |channel| crate::Action::Window(Action::GetRawHandle(id, channel)))
+}
