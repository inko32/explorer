+    /// Records a resize that the platform applied synchronously.
+    ///
+    /// `winit::window::Window::request_inner_size` returns `Some` when the
+    /// backend applied the size change immediately and **no**
+    /// `WindowEvent::Resized` will follow — the Wayland stateless-configure
+    /// path is the notable case. iced must update its own viewport there,
+    /// the same way a `WindowEvent::Resized` does, or it keeps rendering at
+    /// the old size while the compositor displays the new window geometry.
+    pub fn notify_synchronous_resize(
+        &mut self,
+        new_size: winit::dpi::PhysicalSize<u32>,
+        window_scale_factor: f32,
+    ) {
+        let size = Size::new(new_size.width, new_size.height);
+
+        if size == self.viewport.physical_size() {
+            return;
+        }
+
+        self.viewport = Viewport::with_physical_size(
+            size,
+            renderer::Scale {
+                window: window_scale_factor,
+                application: self.viewport.scale().application,
+            },
+        );
+        self.surface_version += 1;
+    }
